#!/bin/sh
# hew CLI 진입점. node_modules 가 없으면 npm ci 를 1회 수행한 뒤 tsx 로 실행한다.
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
if [ ! -x "$ROOT/node_modules/.bin/tsx" ]; then
  (cd "$ROOT" && npm ci --silent) >&2 || { echo "hew: npm ci 실패" >&2; exit 2; }
fi
exec "$ROOT/node_modules/.bin/tsx" "$ROOT/src/cli/main.ts" "$@"
